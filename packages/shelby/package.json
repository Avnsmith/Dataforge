{
  "name": "@dataforge/shelby",
  "version": "1.0.0",
  "main": "dist/client.js",
  "types": "dist/client.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^6.3.1",
    "@shelby-protocol/sdk": "^0.3.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.24",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@shelby-protocol/sdk/node$": "<rootDir>/../../../node_modules/@shelby-protocol/sdk/dist/node/index.mjs"
    },
    "testEnvironment": "node"
  }
}
