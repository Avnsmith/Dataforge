# ==========================================
# DataForge Backend Production Env Template
# Save as /opt/dataforge/env/.env
# ==========================================

NODE_ENV=production
RUN_MODE=api  # api or worker

# PostgreSQL configuration (internal connection to database container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=dataforge

# JWT signing secret
JWT_SECRET=your_secure_jwt_secret_min_32_characters

# Local Redis configuration
REDIS_URL=redis://dataforge_redis:6379

# Shelby Storage SDK configuration
SHELBY_MODE=mock  # mock or live
SHELBY_NETWORK=shelbynet
SHELBY_ACCOUNT=your_aptos_account_address_here
SHELBY_PRIVATE_KEY=your_aptos_private_key_here
SHELBY_RPC_URL=https://rpc.shelby.xyz
SHELBY_EXPLORER_BASE_URL=https://explorer.shelby.xyz/shelbynet

# CORS configuration
FRONTEND_ORIGIN=https://web-gamma-green-wd3aonhbdz.vercel.app
ADDITIONAL_FRONTEND_ORIGINS=http://localhost:3000

# Other parameters
MAX_UPLOAD_FILE_SIZE_MB=25
EMBEDDING_MODE=mock
SENTRY_DSN=
